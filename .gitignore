.cache
.nv
.config
exp/*
*.pyc
*.egg-info
scripts/*
!scripts/jobs/
!scripts/jobs/**
!scripts/audit/
!scripts/audit/**
!scripts/agent_tools/
!scripts/agent_tools/**
# 上面的 `!scripts/<dir>/**` 会把 __pycache__ 一并重新纳入，覆盖通用规则。
# 本条置于白名单之后（后出现者优先）以重新排除。
scripts/**/__pycache__/
data/
dataset_aug/
dataset_norm/
dataset_perturbed/
datasets/
metric_cache
cache
wandb
*.jpg
*.png
*.ckpt
# `*.ckpt` 只匹配文件；ckpts/ 内还有 dinov3_*.pth 等非 .ckpt 权重，
# 导致整个目录以 `?? ckpts/` 出现并触发 §8.2 Step 4 的 dirty 拒跑。
ckpts/
MySubmission
*.json
*.pkl
outputs/
.agents/
.codex/
.agent_jobs/
nuplan-devkit/
process_data/scenarionet/
train_metric_cache/
navsim_one_scene/
nuscenes_mini/

# --- T0.3 工作树清理（2026-09-10）---
# OS 元数据
.DS_Store
# 游离产物：脚本残留的退出码文件
exit_code
# TSUBAME / Grid Engine 作业 stdout / stderr（如 exp0-tl-audit.o8260654）
*.o[0-9]*
*.e[0-9]*
# 包管理器缓存
.pnpm-store/
# 环境变量：§7.1 明标含敏感值，勿入库
env/
# 图件产物（Human 裁决 2026-09-10：整目录 ignore）
docs/figs/
# PPT 工具链：只入库 package.json 与 assets/，不入库依赖树。
# 下面三条否定规则用于抵消上方 L22 的 `*.png` 与 L25 的 `*.json`
# （.gitignore 后出现的规则优先，且 docs/slides/ 本身未被排除，故可重新纳入）。
docs/slides/node_modules/
!docs/slides/package.json
!docs/slides/package-lock.json
!docs/slides/assets/**
# 本地工具（Human 裁决 2026-09-10）
tools/md2pdf/
# 本地 nuScenes mini 副本。注意上方 L35 的 `nuscenes_mini/` 是下划线，
# 与实际目录名 `nuscenes-mini/`（连字符）不匹配，故此处补一条。
nuscenes-mini/
