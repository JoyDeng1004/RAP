#!/bin/bash
#$ -S /bin/bash
#$ -N rap-eval-metric-cache-v2
#$ -j y
#$ -cwd

# UGE wrapper for NAVSIM v2 evaluation metric cache, run with the upstream v2
# devkit ($NAVSIM_DEVKIT_ROOT), not with RAP's v1 navsim.
#
# Set cpu_* and h_rt on the qsub command line, not here.
#
#   qsub -g <group> -l cpu_16=1 -l h_rt=24:00:00 process_data/eval_metric_cache_v2.qsub [split] [workers]
#
# split: navtest (136 logs / 12,146 tokens) or navhard_two_stage
#        (76 logs / 450 real + 5,462 synthetic tokens). Both have data_split=test,
#        so real scenes are read from navsim_logs/test; navhard also reads
#        navhard_two_stage/synthetic_scene_pickles.
#
# The rap env has RAP installed editable, so `import navsim` resolves to v1
# unless the v2 devkit is on PYTHONPATH and the cwd has no navsim/ dir.
# The default worker (ray) dies with psutil.AccessDenied on shared nodes.
# v2 defaults force_feature_computation=True; we pass False so a resubmit
# skips tokens already on disk. The metadata CSV is written only at the end.
#
# Overrides: NAVSIM_DEVKIT_ROOT, CACHE_PATH, PYTHON_BIN, NAVSIM_EXP_ROOT,
#            NUPLAN_MAPS_ROOT, OPENSCENE_DATA_ROOT.

set -euo pipefail

SPLIT="${1:-navtest}"
WORKERS="${2:-12}"

export OPENSCENE_DATA_ROOT="${OPENSCENE_DATA_ROOT:-/gs/bs/tga-RLA/qdeng/navsim_workspace/dataset}"
export NUPLAN_MAPS_ROOT="${NUPLAN_MAPS_ROOT:-$OPENSCENE_DATA_ROOT/maps}"
export NUPLAN_MAP_VERSION="${NUPLAN_MAP_VERSION:-nuplan-maps-v1.0}"
export NAVSIM_EXP_ROOT="${NAVSIM_EXP_ROOT:-/gs/bs/tga-RLA/qdeng/navsim_workspace/exp}"
export NAVSIM_DEVKIT_ROOT="${NAVSIM_DEVKIT_ROOT:-/gs/bs/tga-RLA/qdeng/navsim_workspace/navsim}"
export PYTHONPATH="$NAVSIM_DEVKIT_ROOT${PYTHONPATH:+:$PYTHONPATH}"
export NODE_RANK=0
# One BLAS thread per worker process (see eval_metric_cache.qsub).
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1

PYTHON_BIN="${PYTHON_BIN:-/gs/bs/tga-RLA/qdeng/anaconda3/envs/rap/bin/python}"
CACHE_PATH="${CACHE_PATH:-$NAVSIM_EXP_ROOT/metric_cache_v2_${SPLIT}}"

# Neutral cwd: must not contain a navsim/ package.
cd "$(dirname "$NAVSIM_DEVKIT_ROOT")"

for d in "$OPENSCENE_DATA_ROOT/navsim_logs/test" "$NUPLAN_MAPS_ROOT/$NUPLAN_MAP_VERSION"; do
  [ -d "$d" ] || { echo "缺少目录: $d" >&2; exit 1; }
done

NAVSIM_FILE="$("$PYTHON_BIN" -c 'import navsim; print(navsim.__file__)')"
case "$NAVSIM_FILE" in
  "$NAVSIM_DEVKIT_ROOT"/*) ;;
  *) echo "navsim 解析到 $NAVSIM_FILE，不是 v2 devkit" >&2; exit 1 ;;
esac

EXTRA=()
if [ "$SPLIT" = "navhard_two_stage" ]; then
  SYN_ROOT="$OPENSCENE_DATA_ROOT/navhard_two_stage"
  [ -d "$SYN_ROOT/synthetic_scene_pickles" ] || { echo "缺少目录: $SYN_ROOT/synthetic_scene_pickles" >&2; exit 1; }
  EXTRA=(
    synthetic_sensor_path="$SYN_ROOT/sensor_blobs"
    synthetic_scenes_path="$SYN_ROOT/synthetic_scene_pickles"
  )
fi

echo "[eval-metric-cache-v2] split=$SPLIT workers=$WORKERS cache=$CACHE_PATH navsim=$NAVSIM_FILE"

exec "$PYTHON_BIN" "$NAVSIM_DEVKIT_ROOT/navsim/planning/script/run_metric_caching.py" \
  train_test_split="$SPLIT" \
  metric_cache_path="$CACHE_PATH" \
  force_feature_computation=false \
  worker=single_machine_thread_pool \
  ++worker.use_process_pool=true \
  ++worker.max_workers="$WORKERS" \
  ${EXTRA[@]+"${EXTRA[@]}"}
