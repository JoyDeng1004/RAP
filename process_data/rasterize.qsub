#!/bin/bash
#$ -S /bin/bash
#$ -N rap-raster
#$ -l cpu_16=1
#$ -l h_rt=24:00:00
#$ -j y
#$ -cwd

# UGE array-job wrapper for RAP rasterization.
# The array range must match the shard-count argument.
# Set THREADS to the allocated CPU count.

set -euo pipefail

REPO=/gs/bs/tga-RLA/qdeng/RAP
cd "$REPO"

MODE="${1:?用法: <shard|pilot> <stage> <总片数或试渲染log数>}"
STAGE="${2:?}"
ARG="${3:?}"

case "$MODE" in
  shard) exec bash process_data/rasterize.sh run   "$STAGE" "${SGE_TASK_ID:-1}" "$ARG" ;;
  pilot) exec bash process_data/rasterize.sh pilot "$STAGE" "$ARG" ;;
  *) echo "未知模式: $MODE（可选 shard|pilot）" >&2; exit 1 ;;
esac
