#!/bin/bash
#$ -S /bin/bash
#$ -N rap-e1
#$ -j y
#$ -cwd

# Train on the nuScenes native-rig cache and validate on paired NAVSIM scenes.
# nuScenes has no metric cache, so disable scorer loss and retain full trajectory weight.
# Pass scheduler resources on the qsub command line and environment overrides via -v.
# Smoke test:
#   qsub -g tga-RLA -l gpu_1=1 -l h_rt=0:45:00 -v EXP=E1_smoke,RESUME=null \
#       scripts/jobs/train_e1.qsub trainer.params.fast_dev_run=true
# Full run; resubmit the same command to resume:
#   qsub -g tga-RLA -l node_f=1 -l h_rt=24:00:00 scripts/jobs/train_e1.qsub

set -euo pipefail

REPO="${REPO:-/gs/bs/tga-RLA/qdeng/RAP}"
# Resolve relative checkpoint paths from the repository root.
cd "$REPO"
RAP="$REPO"

export NAVSIM_EXP_ROOT="${NAVSIM_EXP_ROOT:-/gs/bs/tga-RLA/qdeng/navsim_workspace/exp}"
export OPENSCENE_DATA_ROOT="${OPENSCENE_DATA_ROOT:-/gs/bs/tga-RLA/qdeng/navsim_workspace/dataset}"
export NUPLAN_MAPS_ROOT="${NUPLAN_MAPS_ROOT:-$REPO/datasets/navsim/maps}"
export NUPLAN_MAP_VERSION="${NUPLAN_MAP_VERSION:-nuplan-maps-v1.0}"
# Default to offline W&B logging in batch jobs.
export WANDB_MODE="${WANDB_MODE:-offline}"
export HF_HUB_OFFLINE=1

PYTHON_BIN="${PYTHON_BIN:-/gs/bs/tga-RLA/qdeng/anaconda3/envs/rap/bin/python}"
EXP="${EXP:-E1_nusc_nativerig_s0}"
# Select the split before forwarding additional Hydra overrides.
SPLIT="${SPLIT:-nuplan_trainval_paired}"
CACHE="${CACHE:-$RAP/cache/rap_nusc_nativerig}"
RESTRICT="${RESTRICT:-false}"
TRAIN_SCORE_MASK="${TRAIN_SCORE_MASK:-false}"
# Resume from last.ckpt when one exists.
RESUME="${RESUME:-last}"
mkdir -p "$RAP/logs"
LOG="${LOG:-$RAP/logs/${EXP}_${JOB_ID:-local}.log}"

echo "[e1] host=$(hostname) job=${JOB_ID:-local} start=$(date '+%F %T') extra=$*"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader || true

set +e
"$PYTHON_BIN" navsim/planning/script/run_training.py \
  agent=rap_agent \
  dataset=navsim_dataset \
  train_test_split=paired_full \
  train_val_test_log_split="$SPLIT" \
  ++restrict_train_logs="$RESTRICT" \
  experiment_name="$EXP" \
  resume_ckpt_path="$RESUME" \
  use_cache_without_dataset=true \
  force_cache_computation=false \
  cache_path="$CACHE" \
  val_cache_path="$RAP/cache/rap_ego" \
  train_score_mask="$TRAIN_SCORE_MASK" \
  val_score_mask=true \
  agent.config.trajectory_sampling.time_horizon=5 \
  agent.config.train_metric_cache_path="$RAP/train_metric_cache" \
  agent.config.dino_ckpt_path="$RAP/ckpts/dinov3_vith16plus_pretrain_lvd1689m-7c1da9a5.pth" \
  ++agent.config.unscored_traj_weight=1.0 \
  dataloader.params.batch_size=32 \
  dataloader.params.prefetch_factor=4 \
  trainer.params.accumulate_grad_batches=2 \
  trainer.params.max_epochs=20 \
  ++trainer.params.log_every_n_steps=10 \
  "$@" \
  2>&1 | tee "$LOG"
STATUS=${PIPESTATUS[0]}
set -e

echo "[e1] exit=$STATUS end=$(date '+%F %T') log=$LOG"
echo "========== summary =========="
grep -nE "Resume checkpoint|Restored|No checkpoint path|Missing keys|Unexpected keys|Training sources|Validation: [0-9]|Num training|Num validation|Error|Traceback" \
  "$LOG" | head -30 || true
# Check the resolved training configuration.
CFG=$(ls -t "$NAVSIM_EXP_ROOT/$EXP"/*/code/hydra/config.yaml 2>/dev/null | head -1 || true)
[ -n "$CFG" ] && grep -nE "unscored_traj_weight|train_score_mask|val_score_mask|restrict_train_logs|checkpoint_path|time_horizon" "$CFG" || true
# Count deformable-attention CUDA errors.
echo "ms_deformable errors: $(grep -c 'error in ms_deformable' "$LOG" || true)"
# Extract the latest progress-bar metrics.
tr '\r' '\n' < "$LOG" \
  | grep -oE "(train|val)/(loss|min_loss|inter_loss|loss_render|domain_loss|ade_real|score|best_score|final_score_loss|sub_score_loss)(_step|_epoch)?=[^ ,]+" \
  | awk -F= '{last[$1]=$2} END {for (k in last) print k"="last[k]}' | sort || true

exit "$STATUS"
