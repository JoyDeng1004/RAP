#!/bin/bash
#$ -S /bin/bash
#$ -N viz_k0f
#$ -j y
#$ -cwd

# K0 diagnosis V1: real-vs-raster feature cosine heatmaps on the real-only failure tokens of one checkpoint
# (eval/tools/viz_k0_failures.py). Needs the probe run k0probe_<TAG>_<MODEL> and summarize_k0_probe.py's
# eval/k0_results/k0_probe_<TAG>_tail_tokens.csv. Figures go to $RAP/eval/k0_results/figs/<MODEL>/.
#
#   qsub -g tga-RLA -l gpu_1=1 -l h_rt=1:00:00 -o /gs/bs/tga-RLA/qdeng/RAP/qsub_outputs/ \
#       -v RAP_CKPT=<ckpt>,MODEL=D2-K0-scene-mix_last,TAG=k0b[,N_PER_GATE=4,N_CONTROLS=4,N_MEAN=0] viz_k0_failures.qsub

set -euo pipefail

RAP="${RAP:-/gs/bs/tga-RLA/qdeng/RAP}"
EVAL_DIR="${EVAL_DIR:-$RAP/eval}"
: "${RAP_CKPT:?set RAP_CKPT}"
: "${MODEL:?set MODEL}"
: "${TAG:?set TAG}"
AGENT_CONFIG="${AGENT_CONFIG:-$EVAL_DIR/hydra/rap_v2_agent.yaml}"
CACHE_PATH="${CACHE_PATH:-/gs/bs/tga-RLA/qdeng/navsim_workspace/exp/metric_cache_v1_navtest_t1sub}"
SCEN_DIR="${SCEN_DIR:-/gs/bs/tga-RLA/qdeng/navsim_workspace/exp/t2_scenarios_navtest_t1sub}"

export RAP_CKPT RAP_SELECTOR=scorer
export OPENSCENE_DATA_ROOT="${OPENSCENE_DATA_ROOT:-/gs/bs/tga-RLA/qdeng/navsim_workspace/dataset}"
export NUPLAN_MAPS_ROOT="${NUPLAN_MAPS_ROOT:-$OPENSCENE_DATA_ROOT/maps}"
export NUPLAN_MAP_VERSION="${NUPLAN_MAP_VERSION:-nuplan-maps-v1.0}"
export NAVSIM_EXP_ROOT="${NAVSIM_EXP_ROOT:-/gs/bs/tga-RLA/qdeng/navsim_workspace/exp}"
export HF_HUB_OFFLINE=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
# navsim must be RAP's v1 copy: the agent package only, never the v2 devkit.
export PYTHONPATH="$EVAL_DIR/py"

PYTHON_BIN="${PYTHON_BIN:-/gs/bs/tga-RLA/qdeng/anaconda3/envs/rap/bin/python}"

for f in "$RAP_CKPT" "$AGENT_CONFIG" "$EVAL_DIR/tools/viz_k0_failures.py" "$EVAL_DIR/k0_results/k0_probe_${TAG}_tail_tokens.csv"; do
  [ -f "$f" ] || { echo "缺少文件: $f" >&2; exit 1; }
done
[ -d "$NAVSIM_EXP_ROOT/k0probe_${TAG}_${MODEL}" ] || { echo "缺少探针结果: $NAVSIM_EXP_ROOT/k0probe_${TAG}_${MODEL}" >&2; exit 1; }

# Neutral cwd without a navsim/ package; RAP's navsim comes from its editable install.
cd "$EVAL_DIR"
echo "[viz-k0f] host=$(hostname) job=${JOB_ID:-local} model=$MODEL tag=$TAG ckpt=$RAP_CKPT"
exec "$PYTHON_BIN" "$EVAL_DIR/tools/viz_k0_failures.py" \
  --rap-root "$RAP" --agent-config "$AGENT_CONFIG" --scenario-dir "$SCEN_DIR" --metric-cache "$CACHE_PATH" \
  --tag "$TAG" --model "$MODEL" --n-per-gate "${N_PER_GATE:-4}" --n-controls "${N_CONTROLS:-4}" --n-mean "${N_MEAN:-0}"
