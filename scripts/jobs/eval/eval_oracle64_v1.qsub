#!/bin/bash
#$ -S /bin/bash
#$ -N rap-eval-oracle64-v1
#$ -j y
#$ -cwd

# NAVSIM v1 oracle@64 (PDM-Closed + 64 RAP proposals per token) on navtest, RAP's own v1 navsim, no Ray.
# Same environment and token set as eval_pdm_score_v1.qsub; only the runner differs.
#
#   qsub -g tga-RLA -l gpu_1=1 -l h_rt=<from smoke> \
#       -v RAP_CKPT=<ckpt>,AGENT_CONFIG=<yaml>,RAP_SELECTOR=scorer,EXPERIMENT=<name> \
#       jobs/eval_oracle64_v1.qsub [workers]
#
# PER_LOG=2 scores only the first 2 tokens of each log (smoke test, 272 tokens).
# RAP_SELECTOR only picks which index is cross-checked against agent.compute_trajectory;
# both scorer and medoid picks are always reported.

set -euo pipefail

WORKERS="${1:-4}"
EVAL_DIR="${EVAL_DIR:-/gs/bs/tga-RLA/qdeng/rap_eval}"
RAP="${RAP:-/gs/bs/tga-RLA/qdeng/RAP}"
: "${RAP_CKPT:?set RAP_CKPT}"
: "${EXPERIMENT:?set EXPERIMENT}"
AGENT_CONFIG="${AGENT_CONFIG:-$EVAL_DIR/hydra/rap_v2_agent.yaml}"
CACHE_PATH="${CACHE_PATH:-$RAP/metric_cache_v1_navtest}"

export RAP_CKPT RAP_SELECTOR="${RAP_SELECTOR:-scorer}"
export OPENSCENE_DATA_ROOT="${OPENSCENE_DATA_ROOT:-/gs/bs/tga-RLA/qdeng/navsim_workspace/dataset}"
export NUPLAN_MAPS_ROOT="${NUPLAN_MAPS_ROOT:-$OPENSCENE_DATA_ROOT/maps}"
export NUPLAN_MAP_VERSION="${NUPLAN_MAP_VERSION:-nuplan-maps-v1.0}"
export NAVSIM_EXP_ROOT="${NAVSIM_EXP_ROOT:-/gs/bs/tga-RLA/qdeng/navsim_workspace/exp}"
export HF_HUB_OFFLINE=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
# navsim must be RAP's v1 copy: the agent package only, never the v2 devkit.
export PYTHONPATH="$EVAL_DIR/py"

PYTHON_BIN="${PYTHON_BIN:-/gs/bs/tga-RLA/qdeng/anaconda3/envs/rap/bin/python}"
OUTPUT_DIR="${OUTPUT_DIR:-$NAVSIM_EXP_ROOT/$EXPERIMENT/${JOB_ID:-local}}"

for d in "$OPENSCENE_DATA_ROOT/navsim_logs/test" "$OPENSCENE_DATA_ROOT/sensor_blobs/test" "$CACHE_PATH/metadata"; do
  [ -d "$d" ] || { echo "缺少目录: $d" >&2; exit 1; }
done
for f in "$RAP_CKPT" "$AGENT_CONFIG" "$EVAL_DIR/v1/run_oracle64_v1.py" "$EVAL_DIR/v1/oracle64_v1.py" \
         "$EVAL_DIR/py/rap_eval_agents/rap_v2_candidates.py"; do
  [ -f "$f" ] || { echo "缺少文件: $f" >&2; exit 1; }
done

# Neutral cwd without a navsim/ package; RAP's navsim comes from its editable install.
cd "$EVAL_DIR"
echo "[eval-oracle64-v1] host=$(hostname) job=${JOB_ID:-local} workers=$WORKERS ckpt=$RAP_CKPT agent=$AGENT_CONFIG selector=$RAP_SELECTOR cache=$CACHE_PATH out=$OUTPUT_DIR per_log=${PER_LOG:-0}"
exec "$PYTHON_BIN" "$EVAL_DIR/v1/run_oracle64_v1.py" \
  --rap-root "$RAP" --agent-config "$AGENT_CONFIG" --metric-cache "$CACHE_PATH" \
  --output-dir "$OUTPUT_DIR" --workers "$WORKERS" --per-log "${PER_LOG:-0}"
