#!/bin/bash
#$ -S /bin/bash
#$ -N t2swap
#$ -j y
#$ -cwd

# T2 feature-swap intervention (run_t2_swap_v1.py) for one rig preset, NAVSIM v1, RAP's own v1 navsim, no Ray.
# Submitted by submit_t2_swap.sh:
#
#   qsub -g tga-RLA -l gpu_1=1 -l h_rt=6:00:00 -o /gs/bs/tga-RLA/qdeng/RAP/qsub_outputs/ \
#       -v PRESET=<name>,EXPERIMENT=<name>[,T2_TAG=full][,PER_LOG=2,MAX_LOGS=3] eval_t2_swap_v1.qsub [workers]
#
# T2_TAG cross-checks the c1 / new scores per token against t2probe_<T2_TAG>_<preset> (empty = no check).

set -euo pipefail

WORKERS="${1:-4}"
RAP="${RAP:-/gs/bs/tga-RLA/qdeng/RAP}"
EVAL_DIR="${EVAL_DIR:-$RAP/eval}"
: "${PRESET:?set PRESET}"
: "${EXPERIMENT:?set EXPERIMENT}"
T2_TAG="${T2_TAG-full}"
RAP_CKPT="${RAP_CKPT:-/gs/bs/tga-RLA/qdeng/rap_eval/ckpts/official/RAP_DINO_navsimv1.ckpt}"
AGENT_CONFIG="${AGENT_CONFIG:-$EVAL_DIR/hydra/rap_v2_official_agent.yaml}"
CACHE_PATH="${CACHE_PATH:-/gs/bs/tga-RLA/qdeng/navsim_workspace/exp/metric_cache_v1_navtest_t1sub}"
SCEN_DIR="${SCEN_DIR:-/gs/bs/tga-RLA/qdeng/navsim_workspace/exp/t2_scenarios_navtest_t1sub}"

export RAP_CKPT RAP_SELECTOR=scorer
export OPENSCENE_DATA_ROOT="${OPENSCENE_DATA_ROOT:-/gs/bs/tga-RLA/qdeng/navsim_workspace/dataset}"
export NUPLAN_MAPS_ROOT="${NUPLAN_MAPS_ROOT:-$OPENSCENE_DATA_ROOT/maps}"
export NUPLAN_MAP_VERSION="${NUPLAN_MAP_VERSION:-nuplan-maps-v1.0}"
export NAVSIM_EXP_ROOT="${NAVSIM_EXP_ROOT:-/gs/bs/tga-RLA/qdeng/navsim_workspace/exp}"
export HF_HUB_OFFLINE=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
# navsim must be RAP's v1 copy: the agent package only, never the v2 devkit.
export PYTHONPATH="$EVAL_DIR/py"

PYTHON_BIN="${PYTHON_BIN:-/gs/bs/tga-RLA/qdeng/anaconda3/envs/rap/bin/python}"
OUTPUT_DIR="${OUTPUT_DIR:-$NAVSIM_EXP_ROOT/$EXPERIMENT/${JOB_ID:-local}}"

for d in "$OPENSCENE_DATA_ROOT/navsim_logs/test" "$OPENSCENE_DATA_ROOT/sensor_blobs/test" "$CACHE_PATH/metadata" "$SCEN_DIR"; do
  [ -d "$d" ] || { echo "缺少目录: $d" >&2; exit 1; }
done
for f in "$RAP_CKPT" "$AGENT_CONFIG" "$EVAL_DIR/v1/run_t2_swap_v1.py" "$EVAL_DIR/v1/oracle64_v1.py" \
         "$EVAL_DIR/py/rap_eval_agents/rig_probe.py" "$EVAL_DIR/py/rap_eval_agents/t2_render.py" \
         "$EVAL_DIR/py/rap_eval_agents/t2_probe.py" "$RAP/process_data/helpers/renderer.py"; do
  [ -f "$f" ] || { echo "缺少文件: $f" >&2; exit 1; }
done
T2_ARGS=()
if [ -n "$T2_TAG" ]; then
  ls "$NAVSIM_EXP_ROOT/t2probe_${T2_TAG}_${PRESET}"/*/*.csv >/dev/null 2>&1 || { echo "缺少 T2 结果: t2probe_${T2_TAG}_${PRESET}" >&2; exit 1; }
  T2_ARGS=(--t2-tag "$T2_TAG")
fi

# Neutral cwd without a navsim/ package; RAP's navsim comes from its editable install.
cd "$EVAL_DIR"
echo "[t2-swap-v1] host=$(hostname) job=${JOB_ID:-local} workers=$WORKERS preset=$PRESET t2_tag=${T2_TAG:-none} ckpt=$RAP_CKPT scen=$SCEN_DIR out=$OUTPUT_DIR per_log=${PER_LOG:-0} max_logs=${MAX_LOGS:-0}"
exec "$PYTHON_BIN" "$EVAL_DIR/v1/run_t2_swap_v1.py" \
  --rap-root "$RAP" --agent-config "$AGENT_CONFIG" --metric-cache "$CACHE_PATH" --scenario-dir "$SCEN_DIR" \
  --preset "$PRESET" --output-dir "$OUTPUT_DIR" --workers "$WORKERS" ${T2_ARGS[@]+"${T2_ARGS[@]}"} \
  --per-log "${PER_LOG:-0}" --max-logs "${MAX_LOGS:-0}"
