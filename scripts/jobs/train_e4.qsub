#!/bin/bash
#$ -S /bin/bash
#$ -N rap-e4
#$ -j y
#$ -cwd

# E4 = E3 without the nuScenes native-rig pair; every other setting matches E3.
#   main:  NAVSIM K-shot p010 seed0 from cache/rap_ego (score_mask true, rig 0, paired)
#   extra: nusc_navsimrig_raster from cache/rap_nusc_navsimrig (score_mask false, rig 0, use_real false)
# Data, sources and init are fixed here; trains from scratch (agent.checkpoint_path is rejected).
# Pass scheduler resources on the qsub command line and environment overrides via -v.
# Smoke test:
#   qsub -g tga-RLA -l gpu_1=1 -l h_rt=0:45:00 -v EXP=E4_smoke,RESUME=null \
#       scripts/jobs/train_e4.qsub trainer.params.fast_dev_run=true
# Full run on AR 8950 (node_f x1, 10-01 00:00 to 10-04 09:55); resubmit the same command to resume:
#   qsub -g tga-RLA -ar 8950 -l node_f=1 -l h_rt=30:00:00 scripts/jobs/train_e4.qsub

set -euo pipefail

REPO="${REPO:-/gs/bs/tga-RLA/qdeng/RAP}"
# Resolve relative checkpoint paths from the repository root.
cd "$REPO"
RAP="$REPO"

export NAVSIM_EXP_ROOT="${NAVSIM_EXP_ROOT:-/gs/bs/tga-RLA/qdeng/navsim_workspace/exp}"
export OPENSCENE_DATA_ROOT="${OPENSCENE_DATA_ROOT:-/gs/bs/tga-RLA/qdeng/navsim_workspace/dataset}"
export NUPLAN_MAPS_ROOT="${NUPLAN_MAPS_ROOT:-$REPO/datasets/navsim/maps}"
export NUPLAN_MAP_VERSION="${NUPLAN_MAP_VERSION:-nuplan-maps-v1.0}"
# Default to offline W&B logging in batch jobs.
export WANDB_MODE="${WANDB_MODE:-offline}"
export HF_HUB_OFFLINE=1

PYTHON_BIN="${PYTHON_BIN:-/gs/bs/tga-RLA/qdeng/anaconda3/envs/rap/bin/python}"
EXP="${EXP:-E4_navsimrig_raster_p010_s0}"
# Resume from last.ckpt when one exists.
RESUME="${RESUME:-last}"

# E4 definition: not overridable.
SPLIT=navsim_kshot_p010_seed0
CACHE="$RAP/cache/rap_ego"
VAL_CACHE="$RAP/cache/rap_ego"
NAVSIMRIG_CACHE="$RAP/cache/rap_nusc_navsimrig"
TRAIN_METRIC_CACHE="$RAP/train_metric_cache"
DINO_CKPT="$RAP/ckpts/dinov3_vith16plus_pretrain_lvd1689m-7c1da9a5.pth"
SPLIT_YAML="$RAP/navsim/planning/script/config/training/train_val_test_log_split/$SPLIT.yaml"
EXTRA_SOURCES="[{name:nusc_navsimrig_raster,cache_path:$NAVSIMRIG_CACHE,score_mask:false,rig_id:0,use_real:false}]"

mkdir -p "$RAP/logs"
LOG="${LOG:-$RAP/logs/${EXP}_${JOB_ID:-local}.log}"

echo "[e4] host=$(hostname) job=${JOB_ID:-local} start=$(date '+%F %T') extra=$*"
echo "[e4] REPO=$REPO"
echo "[e4] EXP=$EXP RESUME=$RESUME SPLIT=$SPLIT"
echo "[e4] CACHE=$CACHE"
echo "[e4] VAL_CACHE=$VAL_CACHE"
echo "[e4] NAVSIMRIG_CACHE=$NAVSIMRIG_CACHE"
echo "[e4] TRAIN_METRIC_CACHE=$TRAIN_METRIC_CACHE"
echo "[e4] DINO_CKPT=$DINO_CKPT"
echo "[e4] EXTRA_SOURCES=$EXTRA_SOURCES"
echo "[e4] NAVSIM_EXP_ROOT=$NAVSIM_EXP_ROOT OPENSCENE_DATA_ROOT=$OPENSCENE_DATA_ROOT"
echo "[e4] NUPLAN_MAPS_ROOT=$NUPLAN_MAPS_ROOT NUPLAN_MAP_VERSION=$NUPLAN_MAP_VERSION"
echo "[e4] WANDB_MODE=$WANDB_MODE PYTHON_BIN=$PYTHON_BIN LOG=$LOG"

# Abort before launch if the E4 definition or its inputs are off.
fail() { echo "[e4] 启动前检查失败: $*" >&2; exit 1; }
for arg in "$@"; do
  case "$arg" in
    *checkpoint_path*) fail "E4 从头训练，不接受 $arg" ;;
    *extra_train_sources*|*cache_path*|*train_val_test_log_split*|*restrict_train_logs*|*score_mask*) \
      fail "E4 的数据定义写死在脚本里，不接受 $arg" ;;
  esac
done
case "$RESUME" in last|null) ;; *) fail "RESUME 只能是 last 或 null，当前为 $RESUME" ;; esac
[ "$(basename "$CACHE")" = rap_ego ] || fail "主数据 cache 不是 rap_ego: $CACHE"
[ "$(basename "$VAL_CACHE")" = rap_ego ] || fail "验证 cache 不是 rap_ego: $VAL_CACHE"
[ "$(basename "$NAVSIMRIG_CACHE")" = rap_nusc_navsimrig ] || fail "额外数据源不是 rap_nusc_navsimrig: $NAVSIMRIG_CACHE"
case "$CACHE $VAL_CACHE $EXTRA_SOURCES" in *nativerig*) fail "E4 不能包含 nativerig" ;; esac
for d in "$CACHE" "$VAL_CACHE" "$NAVSIMRIG_CACHE" "$TRAIN_METRIC_CACHE"; do
  [ -d "$d" ] || fail "缺少目录: $d"
  n=$(find "$d" -mindepth 1 -maxdepth 1 -type d | wc -l)
  [ "$n" -gt 0 ] || fail "目录为空: $d"
  echo "[e4] ok $d (${n} log dirs)"
done
for f in "$DINO_CKPT" "$SPLIT_YAML"; do
  [ -f "$f" ] || fail "缺少文件: $f"
done
grep -qE '^restrict_train_logs: *true' "$SPLIT_YAML" || fail "$SPLIT_YAML 里没有 restrict_train_logs: true"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader || true

set +e
"$PYTHON_BIN" navsim/planning/script/run_training.py \
  agent=rap_agent \
  dataset=navsim_dataset \
  train_test_split=paired_full \
  train_val_test_log_split="$SPLIT" \
  ++restrict_train_logs=true \
  experiment_name="$EXP" \
  resume_ckpt_path="$RESUME" \
  use_cache_without_dataset=true \
  force_cache_computation=false \
  cache_path="$CACHE" \
  val_cache_path="$VAL_CACHE" \
  train_score_mask=true \
  val_score_mask=true \
  "++extra_train_sources=$EXTRA_SOURCES" \
  agent.config.trajectory_sampling.time_horizon=5 \
  agent.config.train_metric_cache_path="$TRAIN_METRIC_CACHE" \
  agent.config.dino_ckpt_path="$DINO_CKPT" \
  ++agent.config.pdm_workers=16 \
  ++agent.config.unscored_traj_weight=1.0 \
  dataloader.params.batch_size=32 \
  dataloader.params.prefetch_factor=4 \
  trainer.params.accumulate_grad_batches=2 \
  trainer.params.max_epochs=20 \
  seed=0 \
  ++trainer.params.log_every_n_steps=10 \
  "$@" \
  2>&1 | tee "$LOG"
STATUS=${PIPESTATUS[0]}
set -e

echo "[e4] exit=$STATUS end=$(date '+%F %T') log=$LOG"
echo "========== summary =========="
grep -nE "Resume checkpoint|Restored|No checkpoint path|Missing keys|Unexpected keys|Training sources|Validation: [0-9]|Num training samples|Num validation|Error|Traceback|Could not override|HYDRA_FULL_ERROR" \
  "$LOG" | head -30 || true
# Check the resolved training configuration.
CFG=$(ls -t "$NAVSIM_EXP_ROOT/$EXP"/*/code/hydra/config.yaml 2>/dev/null | head -1 || true)
echo "config: ${CFG:-<none>}"
[ -n "$CFG" ] && grep -nE "unscored_traj_weight|train_score_mask|val_score_mask|restrict_train_logs|checkpoint_path|time_horizon|pdm_workers|extra_train_sources|name: nusc|cache_path|rig_id|use_real" "$CFG" || true
# Count deformable-attention CUDA errors.
echo "ms_deformable errors: $(grep -c 'error in ms_deformable' "$LOG" || true)"
# Extract the latest progress-bar metrics, including the per-rig domain losses.
tr '\r' '\n' < "$LOG" \
  | grep -oE "(train|val)/(loss|min_loss|inter_loss|loss_render|domain_loss|domain_loss_rig[01]|ade_real|score|best_score|final_score_loss|sub_score_loss)(_step|_epoch)?=[^ ,]+" \
  | awk -F= '{last[$1]=$2} END {for (k in last) print k"="last[k]}' | sort || true
# Count progress-bar entries where each rig's domain loss is non-zero.
for g in 0 1; do
  tr '\r' '\n' < "$LOG" | grep -oE "train/domain_loss_rig${g}(_step)?=[^ ,]+" \
    | awk -F= -v g="$g" '{n++; if ($2+0 != 0) nz++} END {printf "domain_loss_rig%s: %d entries, %d non-zero\n", g, n, nz}' || true
done

exit "$STATUS"
